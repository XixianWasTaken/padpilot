#!/usr/bin/env bash
# Launcher: finds the package next to this script and the venv in ~/.padpilot.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
HOME_DIR="${PADPILOT_HOME:-$HOME/.padpilot}"
PY="$HOME_DIR/venv/bin/python3"
# Before 0.4 the home was ~/.dualsense-agent; Python moves it on first run, this just finds its venv.
[ -x "$PY" ] || { [ -z "$PADPILOT_HOME" ] && PY="$HOME/.dualsense-agent/venv/bin/python3"; }
[ -x "$PY" ] || PY="$(command -v python3)"
if [ -z "$PY" ]; then echo "padpilot: python3 not found" >&2; exit 0; fi
# Not `python -m padpilot`: that looks in the current directory first, so in a folder that has a
# "padpilot" directory of its own (a checkout of this project, or anything else by that name)
# that code would run instead of the package next to this script.
exec "$PY" -c 'import os, sys
root = sys.argv.pop(1)
try:
    here = os.getcwd()
except OSError:
    here = ""
sys.path[:] = [root] + [p for p in sys.path if p not in ("", here)]
from padpilot.cli import main
sys.exit(main())' "$ROOT" "$@"
