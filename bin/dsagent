#!/usr/bin/env bash
# Launcher: finds the package next to this script and the venv in ~/.dualsense-agent.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
HOME_DIR="${DSAGENT_HOME:-$HOME/.dualsense-agent}"
PY="$HOME_DIR/venv/bin/python3"
[ -x "$PY" ] || PY="$(command -v python3)"
if [ -z "$PY" ]; then echo "dsagent: python3 not found" >&2; exit 0; fi
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m dsagent "$@"
